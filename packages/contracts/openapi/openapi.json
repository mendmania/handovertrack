            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "assignment": {
            "$ref": "#/components/schemas/Assignment"
          }
