          "complete",
          "generatedAt",
          "projects"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "complete": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "projects": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          }
