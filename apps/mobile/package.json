    "better-auth": "1.7.5",
    "expo": "57.0.24",
    "expo-camera": "57.0.5",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-device": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.10",
    "expo-network": "57.0.2",
    "expo-router": "57.0.22",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.3",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
