NODE_ENV=development
COMPOSE_PROJECT_NAME=handovertrack-local
POSTGRES_PORT=55432
POSTGRES_PASSWORD=generate-with-pnpm-setup-local
MIGRATOR_PASSWORD=generate-with-pnpm-setup-local
RUNTIME_PASSWORD=generate-with-pnpm-setup-local
MIGRATION_DATABASE_URL=postgresql://htrack_migrator:REPLACE@127.0.0.1:55432/handovertrack
DATABASE_URL=postgresql://htrack_runtime:REPLACE@127.0.0.1:55432/handovertrack
TEST_MIGRATION_DATABASE_URL=postgresql://htrack_migrator:REPLACE@127.0.0.1:55432/handovertrack_test
TEST_DATABASE_URL=postgresql://htrack_runtime:REPLACE@127.0.0.1:55432/handovertrack_test
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_BASE_URL=http://localhost:3300
WEB_ORIGIN=http://localhost:3300
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3300
API_INTERNAL_URL=http://127.0.0.1:3301
API_HOST=127.0.0.1
API_PORT=3301
WEB_PORT=3300
EXPO_PUBLIC_API_ORIGIN=http://localhost:3301
WORKER_HEARTBEAT_MS=30000
SEED_PASSWORD=REPLACE_WITH_GENERATED_DEV_PASSWORD
ALLOW_DEV_SEED=true
